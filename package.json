{
  "name": "@local/deepseek-peak-indicator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sidebar-foot DeepSeek API peak / off-peak pricing indicator with a minimal countdown popover.",
  "license": "MIT",
  "author": {
    "name": "Jalil Ahmad Fazeli",
    "email": "jalilahmad.fazeli@gmail.com",
    "url": "https://github.com/jalilahmad"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jalilahmad/deepseek-peak-indicator.git"
  },
  "homepage": "https://github.com/jalilahmad/deepseek-peak-indicator#readme",
  "bugs": {
    "url": "https://github.com/jalilahmad/deepseek-peak-indicator/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "deepseek",
    "peak-indicator",
    "usage-pricing",
    "off-peak",
    "pricing",
    "sidebar",
    "cordis-plugin"
  ],
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "holidays.json",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/schedule.test.mjs",
    "sync:holidays": "node tools/sync-holidays.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
